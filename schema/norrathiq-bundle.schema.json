{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norrathiq.invalid/schema/bundle-v1.json",
  "title": "NorrathIQ portable bundle manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "source"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" },
    "realmSource": { "type": "string" },
    "realmVersion": { "type": "string" },
    "primarySourceId": { "type": "string" },
    "eqwowSnapshot": { "type": "string" },
    "eqwowSnapshotDate": { "type": "string" },
    "sourceSnapshots": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "confidence"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "integer"] },
        "timestamp": { "type": ["string", "null"] },
        "pageId": { "type": ["integer", "null"] },
        "sourceId": { "type": "string" },
        "recordId": { "type": ["integer", "string"] },
        "snapshotId": { "type": "string" },
        "snapshotDate": { "type": "string" },
        "contentHash": { "type": "string" },
        "transport": { "enum": ["unverified-http", "https", "local", "capture"] },
        "confidence": { "enum": ["low", "medium", "high", "approximate", "unknown"] }
      }
    },
    "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+:.+" },
        "type": { "enum": ["item", "npc", "quest", "recipe", "zone", "container", "object", "spell"] },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "realmId": { "type": ["string", "integer"] },
        "clientId": { "type": ["string", "integer"] },
        "fieldOrigins": { "type": "object", "additionalProperties": { "type": "string" } },
        "p99PageId": { "type": "integer" },
        "weaponDamageMin": { "type": "number", "minimum": 0 },
        "weaponDamageMax": { "type": "number", "minimum": 0 },
        "weaponSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "$ref": "#/$defs/source" },
        "map": {
          "type": "object",
          "required": ["zone"],
          "properties": {
            "zone": { "type": "string" },
            "x": { "$ref": "#/$defs/coordinate" },
            "y": { "$ref": "#/$defs/coordinate" },
            "confidence": { "type": "string" }
          }
        },
        "nativeMap": {
          "type": "object",
          "required": ["mapId", "x", "y"],
          "properties": {
            "mapId": { "type": "integer" },
            "x": { "$ref": "#/$defs/coordinate" },
            "y": { "$ref": "#/$defs/coordinate" }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "relation", "to", "source"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "relation": {
          "enum": ["DROPPED_BY", "SPAWNS_AT", "QUEST_INPUT", "QUEST_REWARD", "TURN_IN_TO", "RECIPE_INPUT", "CRAFTED_BY", "COMPANION_ITEM", "KEY_STEP", "RELATED_TO", "SOLD_BY", "TRAINED_BY", "QUEST_GIVER"]
        },
        "confidence": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
